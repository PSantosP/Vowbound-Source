# 서드파티 빌드
ThirdParty/**/Binaries/
ThirdParty/**/Build/
ThirdParty/**/Intermediate/

############################
# Unreal Engine 에디터 캐시
############################
Saved/
DerivedDataCache/

# 빌드 데이터
*_BuiltData.uasset

# 외부 액터/오브젝트
Content/__ExternalActors__/
Content/__ExternalObjects__/


# 로그 & 크래시 덤프
############################
*.log
*.dmp
*.uetlog

############################
# 문서 폴더
############################
Docs/

############################
# AI 하네스 (2026-08-25 부터 추적한다)
############################
# 종전에는 `.claude/` 를 통째로 무시했다. 그래서 하네스를 잘못 건드려도 되돌릴 데가 없었고,
# "이게 언제부터 이랬지"를 물어볼 데도 없었다. 실제로 2026-08-24~25 이틀 사이에 훅 규칙이
# 서로 반대를 말하는 자리가 여럿 나왔는데 전부 손으로 다시 재는 수밖에 없었다.
# 그래서 규칙과 도구는 추적하고, 실행 중에 생기는 찌꺼기만 무시한다.

# 실행 산출물 — 38MB, 자산 사본과 조사 덤프가 들어 있다. 추적 대상이 아니다.
# ★디렉터리째(`runtime/`)가 아니라 내용물(`runtime/*`)을 무시한다.★ 디렉터리를 통째로 빼면
# 그 안의 파일 하나를 되살리는 `!` 규칙이 먹지 않는다 (git 이 디렉터리에서 이미 멈춘다).
.claude/runtime/*
# 원장은 예외다. "지금 무엇이 열려 있나"의 유일한 홈이라 이력이 남아야 한다.
# 2026-08-25 v2: 정본은 항목당 한 파일(items/)이고 open-items.md 는 거기서 생성한 색인이다.
# 디렉터리를 되살리는 줄이 먼저 와야 그 안의 파일에 무시 규칙이 안 걸린다.
!.claude/runtime/items/
!.claude/runtime/open-items.md

.claude/logs/
.claude/worktrees/
.claude/watch/
.claude/agent-memory/
.claude/settings.local.json.backup
.claude/**/__pycache__/
.claude/**/*.pyc

############################
# OS 임시파일
############################
.DS_Store
Thumbs.db
desktop.ini

############################
# 컴파일 산출물
############################
*.obj
*.o
*.lo
*.slo
*.lib
*.a
*.dll
*.dylib
*.so
*.exe
*.out
*.app
*.ipa
*.pdb
*.map

###############################################################################
#  Config 정책 (🔴 핵심!)
###############################################################################
# 1단계: Saved에 있는 모든 .ini 무시
Saved/**/*.ini

# 2단계: Config/ 폴더는 추적
!Config/

# 3단계: Config 내 필수 .ini 파일만 선택적 추적
!Config/Default*.ini           # ✅ 기본 설정 (필수!)
!Config/Custom*.ini            # ✅ 커스텀 설정 (팀 공유)

# 4단계: 개인 설정은 무시
Config/*UserSettings.ini       # ❌ 개발자별 에디터 설정
Config/*EditorPerProjectUserSettings.ini  # ❌ 개인 환경 설정

###############################################################################
#  화이트리스트 – 반드시 추적
###############################################################################
!*.uproject
!Source/
!Content/
!Plugins/

# Plugins 내 소스는 추적, 빌드는 무시
!Plugins/*/Source/
!Plugins/*/Config/
!Plugins/*/Content/
!Plugins/*/Resources/

###############################################################################
#  SVN 연동 - Content 폴더 전체 무시
###############################################################################
Content/

# SVN 메타데이터 무시
.svn/

# SVN 충돌 파일
*.mine
*.r*
*.svn-base

###############################################################################
#  Node.js / JS tooling
###############################################################################
node_modules/

###############################################################################
#  Python 캐시
###############################################################################
__pycache__/
*.pyc

###############################################################################
#  대용량 원본 에셋 (임포트 전 FBX / Mixamo / raw)
#  RawAssets는 14GB+ 절대 커밋 금지
###############################################################################
/RawAssets/
/MixamoAnim/
/Microsoft/
/Resource/

###############################################################################
#  툴 빌드 산출물
###############################################################################
/artifacts/
/dist/
/codexruntime/

###############################################################################
#  Serena MCP project memory (local, regenerable)
###############################################################################
/.serena/

###############################################################################
#  로컬 전용 — 개인 환경이라 공유하지 않는 것들
#  (하네스 본체와 CLAUDE.md/AGENTS.md/.mcp.json 은 2026-08-25 부터 추적한다. 위쪽 블록 참조)
###############################################################################
# CLAUDE.md / AGENTS.md / .mcp.json 은 2026-08-25 부터 추적한다.
# 공식 지침도 "CLAUDE.md 는 git 에 넣어라"라고 한다 — 규칙이 언제 왜 바뀌었는지가 남아야
# 다음에 같은 자리를 다시 따지지 않는다. .mcp.json 은 어느 서버를 붙였는지의 기록이다.
/.codex/
/.agents/
/package.json
/package-lock.json
/tools/
# 과제 산출물 폴더의 무시 규칙은 이 파일에 두지 않는다 (user 지시 2026-08-26).
# 그 이름이 추적되는 파일에 들어가면 안 되므로 규칙을 .git/info/exclude 로 옮겼다 -
# 같은 일을 하면서 커밋에는 안 들어가는 자리다. 새로 클론하면 그 파일이 없으니 다시 넣어야 한다.

###############################################################################
#  Sensitive credentials — NEVER commit
###############################################################################
*Password*.txt
*password*.txt
*credentials*
*.key
*.pem
*secret*
*token*
.env
.env.*

# 위 자격증명 패턴에서 코드 파일만 되살린다.
# 이유: 클래스 이름에 Token/Secret 이 들어가는 것은 정상이다(어택 토큰 체계 등).
#   실제로 VBBTDecorator_HasAttackToken.{h,cpp} 두 파일이 *token* 에 걸려
#   디스크에 존재하고 빌드에도 들어가면서 어느 브랜치에도 커밋된 적이 없었다(2026-08-22 적발).
#   git status 에 M 도 ?? 도 안 뜨는 종류의 소실이라 커밋 직전까지 안 보인다.
# 안전성: 자격증명이 .h/.cpp/.cs 확장자로 저장되는 일은 없으므로 차단력은 그대로다.
#   .txt/.json/.env/.key/.pem 등 실제 자격증명 형식은 위 패턴이 계속 잡는다.
# 주의: 부모 디렉터리가 제외되면 되살아나지 않는다는 git 규칙 덕에
#   Binaries/ Intermediate/ 안의 코드 파일은 여전히 무시된다.
!*.h
!*.cpp
!*.cs

# Public source snapshot: private development environment stays local
.claude/
.mcp.json
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
*.key
*.keystore
